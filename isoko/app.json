{
  "expo": {
    "name": "Isoko",
    "slug": "isoko",
    "scheme": "isoko",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.isoko.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.isoko.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B6E5C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#062F2B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Isoko needs access to your photos so you can add pictures of your house, car or accessory to your listing.",
          "cameraPermission": "Isoko needs your camera so you can take pictures for your listing.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Isoko uses your location only when you tap “use my location”, to pin your house or car on Google Maps for buyers and renters."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
